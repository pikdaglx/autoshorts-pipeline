# ==============================================================================
# CONFIGURAÇÕES DO AUTOCORTES SHORTS PIPELINE
# Copie este arquivo para `.env` e preencha suas chaves:
#   cp .env.example .env
# ==============================================================================

# Diretório de saída dos vídeos renderizados
OUTPUT_DIR=./output

# Chave da API do Google Gemini (Opcional - Recomendado para mineração via LLM)
# Obtenha gratuitamente em: https://aistudio.google.com/apikey
# Caso fique em branco, o pipeline usará automaticamente o motor heurístico + Whisper local.
GEMINI_API_KEY=

# Configurações de renderização dos Shorts (Padrão Vertical 9:16 Full HD)
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# Tamanho da fonte das legendas dinâmicas (.ass) queimadas no vídeo
SUBTITLE_FONT_SIZE=74

# Caminho opcional para arquivo de cookies do YouTube (formato Netscape)
# Útil caso rode em servidores cloud/VPS que exijam autenticação contra bot-check
YOUTUBE_COOKIES_FILE=cookies.txt
